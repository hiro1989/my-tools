{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "skillListingBudgetFraction": 0.015,
  "permissions": {
    "allow": [
      "Bash(actionlint:*)",
      "Bash(basename:*)",
      "Bash(checkov:*)",
      "Bash(date:*)",
      "Bash(df:*)",
      "Bash(dirname:*)",
      "Bash(du:*)",
      "Bash(echo $CI)",
      "Bash(echo $CLAUDE_CODE_REMOTE)",
      "Bash(fd:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(free:*)",
      "Bash(gh api 'repos/{owner}/{repo}/pulls?head={owner}:{branch}&state=open' --jq 'if length == 0 then error(\"no open PR for this branch\") else .[] | {number, url: .html_url} end')",
      "Bash(gh auth status)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search issues:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch --all --prune)",
      "Bash(git fetch --all)",
      "Bash(git fetch --prune)",
      "Bash(git fetch --tags:*)",
      "Bash(git fetch origin main --tags:*)",
      "Bash(git fetch origin main)",
      "Bash(git fetch origin)",
      "Bash(git fetch)",
      "Bash(git for-each-ref:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash list)",
      "Bash(git status:*)",
      "Bash(git worktree list)",
      "Bash(groups:*)",
      "Bash(hostname)",
      "Bash(id:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(playwright-cli --raw console:*)",
      "Bash(playwright-cli click:*)",
      "Bash(playwright-cli close:*)",
      "Bash(playwright-cli console:*)",
      "Bash(playwright-cli fill:*)",
      "Bash(playwright-cli find:*)",
      "Bash(playwright-cli open:*)",
      "Bash(playwright-cli press:*)",
      "Bash(playwright-cli screenshot:*)",
      "Bash(playwright-cli snapshot:*)",
      "Bash(pnpm exec bats:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(ps:*)",
      "Bash(pwd:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(shellcheck:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tflint:*)",
      "Bash(tfsort:*)",
      "Bash(uname:*)",
      "Bash(uptime)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "mcp__claude-code-remote__send_message",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "NotebookEdit",
      "mcp__ide__executeCode",
      "Bash(git push * +*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf /)",
      "Read(.env)",
      "Read(**/.env)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(**/node_modules/**)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(node_modules/**)",
      "Edit(pnpm-lock.yaml)"
    ],
    "ask": []
  },
  "hooks": {
    "SessionStart": [],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": []
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-pnpm.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
